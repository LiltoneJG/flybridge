{
    "version": 1,
    "agents": {
        "codex": {
            "executables": ["codex"],
            "arguments": ["--dangerously-bypass-approvals-and-sandbox"],
            "model_arguments": ["--model", "{model}"],
            "prompt_arguments": ["{prompt}"],
            "builtin_tui": false,
            "builtin_models": []
        },
        "claude": {
            "executables": ["claude"],
            "arguments": ["--dangerously-skip-permissions"],
            "model_arguments": ["--model", "{model}"],
            "prompt_arguments": ["{prompt}"],
            "builtin_tui": false,
            "builtin_models": []
        },
        "cursor": {
            "executables": ["cursor-agent", "agent"],
            "arguments": ["--trust", "--yolo"],
            "model_arguments": ["--model", "{model}"],
            "prompt_arguments": ["{prompt}"],
            "builtin_tui": true,
            "builtin_models": ["auto"]
        }
    }
}
